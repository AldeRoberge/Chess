{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess-experience",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  // Keyed proxy to OpenAI / ElevenLabs under /chess/api/* (keys stay in KV, never in the browser).
  "main": "worker/index.ts",
  // One-time: `npx wrangler kv namespace create KEYS`, paste the id below, then `npx wrangler secret put ADMIN_PASSPHRASE`.
  "kv_namespaces": [{ "binding": "KEYS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": { "ALLOWED_ORIGINS": "alderoberge.com", "RATE_PER_MIN": "30", "DAILY_LIMIT": "3000" },
  // Only /chess on alderoberge.com. The rest of the domain stays on Firebase Hosting.
  "routes": [
    { "pattern": "alderoberge.com/chess", "zone_name": "alderoberge.com" },
    { "pattern": "alderoberge.com/chess/*", "zone_name": "alderoberge.com" }
  ],
  // Static build (npm run build) lands in dist/chess/, so URLs keep the /chess/ prefix.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/chess/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
