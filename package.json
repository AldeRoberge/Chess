{
  "name": "chess-experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nodal real-time chess table: multi-camera vision, narrator, scenes, projection mapping.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:simulation": "vitest run src/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:stockfish": "node scripts/setup-stockfish.mjs",
    "bridge:dmx": "node bridge/dmx-bridge.mjs",
    "coverage": "vitest run --coverage",
    "split": "bash scripts/split-to-new-repo.sh",
    "check": "tsc --noEmit && vitest run --coverage && vite build",
    "check:ci": "tsc --noEmit && vitest run --coverage --exclude src/e2e.test.ts && vite build"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "chess.js": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "stockfish": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0",
    "wrangler": "^4.165.0"
  }
}
